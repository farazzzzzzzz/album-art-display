[Unit]
Description=Control Album Display Power from Plex Playback
After=album-kiosk.service
Wants=album-kiosk.service

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
ExecStart=/usr/bin/python3 %h/.config/album-display/screen-power.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
